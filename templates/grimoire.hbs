<div class="grimoire" style="--grimoire-cover: {{cover}}">
  <header class="grimoire-cover-bar">
    <div class="grimoire-title">
      <i class="fa-solid fa-book-journal-whills"></i>
      <span>{{localize "WFRP4E_GRIMOIRE.WrittenIn" language=languageLabel}}</span>
      {{#if actorName}}<span class="grimoire-owner">· {{actorName}}</span>{{/if}}
    </div>
    <div class="grimoire-badges">
      {{#each badges}}
        <span class="grimoire-badge {{#if ok}}ok{{else}}missing{{/if}}">
          <i class="fa-solid {{#if ok}}fa-check{{else}}fa-xmark{{/if}}"></i> {{label}}
        </span>
      {{/each}}
      {{#if showCarried}}
        <span class="grimoire-badge {{#if carried}}ok{{else}}missing{{/if}}">
          <i class="fa-solid fa-hand-holding"></i>
          {{#if carried}}{{localize "WFRP4E_GRIMOIRE.Badge.carried"}}{{else}}{{localize "WFRP4E_GRIMOIRE.Badge.notCarried"}}{{/if}}
        </span>
      {{/if}}
      {{#if canEdit}}
        <button type="button" class="grimoire-edit-toggle {{#if editMode}}active{{/if}}" data-action="toggleEdit" data-tooltip="{{localize 'WFRP4E_GRIMOIRE.Edit.Toggle'}}">
          <i class="fa-solid fa-feather-pointed"></i>
        </button>
      {{/if}}
    </div>
  </header>

  {{#if editMode}}
    <section class="grimoire-editbar">
      <label>{{localize "WFRP4E_GRIMOIRE.Edit.Language"}}
        <select name="language">
          {{#each languages}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          {{#if customLanguage}}<option value="{{customLanguage}}" selected>{{customLanguage}}</option>{{/if}}
        </select>
      </label>
      <label>{{localize "WFRP4E_GRIMOIRE.Edit.CustomLanguage"}}
        <input type="text" name="customLanguage" value="{{customLanguage}}" placeholder="Eltharin">
      </label>
      <label>{{localize "WFRP4E_GRIMOIRE.Edit.Cover"}}
        <input type="color" name="cover" value="{{cover}}">
      </label>
      <button type="button" data-action="describe"><i class="fa-solid fa-scroll"></i> {{localize "WFRP4E_GRIMOIRE.Edit.Describe"}}</button>
      <span class="grimoire-drop-hint"><i class="fa-solid fa-hand-pointer"></i> {{localize "WFRP4E_GRIMOIRE.Edit.DropHint"}}</span>
    </section>
  {{/if}}

  <div class="grimoire-spread">
    <section class="grimoire-page left">
      <div class="grimoire-search">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input type="search" name="search" value="{{search}}" placeholder="{{localize 'WFRP4E_GRIMOIRE.Search'}}">
      </div>
      <div class="grimoire-toc-list">
        {{#if empty}}
          <p class="grimoire-empty">
            {{#if canEdit}}{{localize "WFRP4E_GRIMOIRE.EmptyEditable"}}{{else}}{{localize "WFRP4E_GRIMOIRE.Empty"}}{{/if}}
          </p>
        {{/if}}
        {{#each groups}}
          <div class="grimoire-lore lore-{{lore}}">
            <i class="fa-solid fa-bookmark"></i> {{label}}
          </div>
          {{#each entries}}
            <div class="grimoire-entry status-{{status}} {{#if selected}}selected{{/if}}" data-entry-id="{{id}}" data-action="selectSpell">
              <span class="grimoire-entry-name">
                {{#if (eq status "known")}}<i class="fa-solid fa-check" data-tooltip="{{statusLabel}}"></i>{{/if}}
                {{#if (eq status "readOnly")}}<i class="fa-solid fa-eye" data-tooltip="{{statusLabel}}"></i>{{/if}}
                {{#if (eq status "unmemorized")}}<i class="fa-solid fa-book-open" data-tooltip="{{statusLabel}}"></i>{{/if}}
                {{#if (eq status "learnable")}}<i class="fa-solid fa-graduation-cap" data-tooltip="{{statusLabel}}"></i>{{/if}}
                {{name}}
              </span>
              <span class="grimoire-entry-cn">{{#if cn}}{{localize "WFRP4E_GRIMOIRE.CNShort"}} {{cn}}{{/if}}</span>
              {{#if ../../editMode}}
                <span class="grimoire-entry-edit">
                  <a data-action="moveUp" data-tooltip="{{localize 'WFRP4E_GRIMOIRE.Edit.Up'}}"><i class="fa-solid fa-arrow-up"></i></a>
                  <a data-action="moveDown" data-tooltip="{{localize 'WFRP4E_GRIMOIRE.Edit.Down'}}"><i class="fa-solid fa-arrow-down"></i></a>
                  <a data-action="removeSpell" data-tooltip="{{localize 'WFRP4E_GRIMOIRE.Edit.Remove'}}"><i class="fa-solid fa-trash"></i></a>
                </span>
              {{/if}}
            </div>
          {{/each}}
        {{/each}}
      </div>
    </section>

    <div class="grimoire-spine"></div>

    <section class="grimoire-page right">
      {{#if details}}
        <div class="grimoire-details" data-entry-id="{{details.id}}">
          <div class="grimoire-details-lore">{{details.lore}}</div>
          <h2 class="grimoire-details-name">{{details.name}}</h2>
          {{#if details.hidden}}
            <p class="grimoire-illegible-note"><i class="fa-solid fa-eye-slash"></i> {{localize "WFRP4E_GRIMOIRE.Illegible"}}</p>
          {{else}}
            <div class="grimoire-stats">
              <div><span>{{localize "WFRP4E_GRIMOIRE.Stat.CN"}}</span><b>{{details.cn}}</b>{{#if details.baseCN}}<small>{{localize "WFRP4E_GRIMOIRE.Stat.CNMemorized" cn=details.baseCN}}</small>{{/if}}</div>
              <div><span>{{localize "WFRP4E_GRIMOIRE.Stat.Range"}}</span><b>{{details.range}}</b></div>
              <div><span>{{localize "WFRP4E_GRIMOIRE.Stat.Target"}}</span><b>{{details.target}}</b></div>
              <div><span>{{localize "WFRP4E_GRIMOIRE.Stat.Duration"}}</span><b>{{details.duration}}</b></div>
            </div>
            <div class="grimoire-description">{{{details.description}}}</div>
          {{/if}}
          <p class="grimoire-note status-{{details.status}}">{{details.note}}</p>
          <div class="grimoire-actions">
            {{#if details.canCast}}
              <button type="button" class="primary" data-action="cast"><i class="fa-solid fa-wand-sparkles"></i> {{localize "WFRP4E_GRIMOIRE.Action.Cast"}}</button>
            {{/if}}
            {{#if details.canChannel}}
              <button type="button" data-action="channel"><i class="fa-solid fa-hurricane"></i> {{localize "WFRP4E_GRIMOIRE.Action.Channel"}}</button>
            {{/if}}
            {{#if details.canLearn}}
              <button type="button" data-action="learn"><i class="fa-solid fa-graduation-cap"></i> {{localize "WFRP4E_GRIMOIRE.Action.Learn"}}</button>
            {{/if}}
            {{#unless details.hidden}}
              <button type="button" data-action="chat"><i class="fa-solid fa-comment"></i> {{localize "WFRP4E_GRIMOIRE.Action.Chat"}}</button>
              <button type="button" data-action="openSpell"><i class="fa-solid fa-up-right-from-square"></i> {{localize "WFRP4E_GRIMOIRE.Action.Open"}}</button>
            {{/unless}}
          </div>
        </div>
      {{else}}
        <div class="grimoire-details grimoire-blank">
          <i class="fa-solid fa-feather"></i>
        </div>
      {{/if}}
    </section>
  </div>
</div>
