<div class="scroll-parchment">
  <div class="scroll-rod top"></div>

  <header class="scroll-head">
    <div class="scroll-meta">
      <span><i class="fa-solid fa-scroll"></i> {{localize "WFRP4E_GRIMOIRE.WrittenIn" language=languageLabel}}</span>
      <span class="scroll-count" data-tooltip="{{localize 'WFRP4E_GRIMOIRE.Scroll.CountTooltip'}}">× {{count}}</span>
    </div>
    <div class="scroll-badges">
      {{#each badges}}
        <span class="grimoire-badge {{#if ok}}ok{{else}}missing{{/if}}">
          <i class="fa-solid {{#if ok}}fa-check{{else}}fa-xmark{{/if}}"></i> {{label}}
        </span>
      {{/each}}
      {{#if canEdit}}
        <button type="button" class="scroll-edit-toggle {{#if editMode}}active{{/if}}" data-action="toggleEdit" data-tooltip="{{localize 'WFRP4E_GRIMOIRE.Scroll.Edit'}}">
          <i class="fa-solid fa-feather-pointed"></i>
        </button>
      {{/if}}
    </div>
  </header>

  {{#if editMode}}
    <section class="scroll-editbar">
      <label>{{localize "WFRP4E_GRIMOIRE.Edit.Language"}}
        <select name="language">
          {{#each languages}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          {{#if customLanguage}}<option value="{{customLanguage}}" selected>{{customLanguage}}</option>{{/if}}
        </select>
      </label>
      <label>{{localize "WFRP4E_GRIMOIRE.Edit.CustomLanguage"}}
        <input type="text" name="customLanguage" value="{{customLanguage}}" placeholder="Eltharin">
      </label>
      <span class="grimoire-drop-hint"><i class="fa-solid fa-hand-pointer"></i> {{localize "WFRP4E_GRIMOIRE.Scroll.DropHint"}}</span>
    </section>
  {{/if}}

  <div class="scroll-body">
    {{#if details}}
      <div class="scroll-lore">{{details.subtitle}}</div>
      <h2 class="scroll-name">{{details.name}}</h2>
      {{#if hidden}}
        <p class="grimoire-illegible-note"><i class="fa-solid fa-eye-slash"></i> {{localize "WFRP4E_GRIMOIRE.Illegible"}}</p>
      {{else}}
        <div class="grimoire-stats">
          {{#each details.stats}}<div><span>{{label}}</span><b>{{value}}</b>{{#if hint}}<small>{{hint}}</small>{{/if}}</div>{{/each}}
        </div>
        <div class="grimoire-description">{{{details.description}}}</div>
      {{/if}}
    {{else}}
      <p class="grimoire-empty">
        {{#if canEdit}}{{localize "WFRP4E_GRIMOIRE.Scroll.EmptyEditable"}}{{else}}{{localize "WFRP4E_GRIMOIRE.Scroll.Empty"}}{{/if}}
      </p>
    {{/if}}
  </div>

  {{#if details}}
    <footer class="scroll-foot">
      {{#if details.note}}<p class="grimoire-note">{{details.note}}</p>{{/if}}
      <div class="grimoire-actions">
        {{#each details.actions}}
          <button type="button" {{#if primary}}class="primary"{{/if}} data-action="entryAction" data-entry-action="{{id}}"><i class="fa-solid {{icon}}"></i> {{label}}</button>
        {{/each}}
      </div>
    </footer>
  {{/if}}

  <div class="scroll-rod bottom"></div>
</div>
